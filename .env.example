# Variáveis de ambiente
# Copie este arquivo para .env e preencha com valores reais.

# Banco de dados
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agenda-tenis?schema=public"

# API
PORT=3000

# Configurações SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# E-mail destinatário das reservas
RECIPIENT_EMAIL=destinatario@exemplo.com

# E-mail remetente (aparece no "De")
SENDER_NAME=Agenda Tenis
SENDER_EMAIL=seu-email@gmail.com
